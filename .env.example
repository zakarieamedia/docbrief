# Copy to .env.local and fill in. Never commit real values.

# ── Client (bundled into the browser; safe to expose, protected by RLS) ──
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Shows the Admin page in the UI. Access is actually enforced by the RLS
# policies in supabase/schema.sql, so keep the two in sync.
VITE_ADMIN_EMAIL=

# ── Server (read only by api/summarize.js; never exposed to the browser) ──
ANTHROPIC_API_KEY=
SUPABASE_URL=
# Full-access key, used only to validate callers' session tokens.
SUPABASE_SERVICE_ROLE_KEY=
